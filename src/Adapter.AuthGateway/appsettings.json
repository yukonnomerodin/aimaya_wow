{
  "AuthListener": {
    "BindAddress": "0.0.0.0",
    "Port": 1119,
    "Backlog": 1024,
    "ReaderBufferSize": 65536,
    "MinimumReadSize": 2048,
    "MaxPacketBodyBytes": 524288,
    "MaxBnetHeaderBytes": 4096,
    "EnableFileLogging": true,
    "LogFilePath": "docs/handshake/runlogs/authgateway.log.txt",
    "ClearLogFileOnStart": false
  },
  "AuthSession": {
    "SessionTtlSeconds": 120,
    "CleanupIntervalSeconds": 15
  },
  "AuthOpcodes": {
    "FilePath": "opcodes.json"
  },
  "Database": {
    "ConnectionString": "Server=127.0.0.1;Port=3306;Database=acore_auth;User ID=aimaya;Password=aimaya;SslMode=Preferred",
    "MinimumPoolSize": 16,
    "MaximumPoolSize": 512,
    "ConnectionTimeoutSeconds": 15,
    "CommandTimeoutSeconds": 30
  }
}
